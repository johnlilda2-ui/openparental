{
  "name": "openparental-backend",
  "version": "0.1.0",
  "description": "OpenParental backend — auth, pairing, command spine, policy, events, tamper, heartbeat, alerts",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/websockets": "^12.3.2",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "jest": "^30.2.0",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  },
  "overrides": {
    "@fastify/busboy": "^3.2.2",
    "@grpc/grpc-js": "^1.14.5",
    "body-parser": "^1.20.9",
    "glob": "^10.5.0",
    "lodash": "^4.17.24",
    "multer": "^2.5.0",
    "picomatch": "^4.0.4",
    "tar": "^7.5.21",
    "tmp": "^0.2.6"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
